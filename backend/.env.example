# Writing the .env.example content to a file
env_example_content = """
# .env.example

# Flask settings
FLASK_ENV=development
SECRET_KEY=your-secret-key
JWT_SECRET_KEY=your-jwt-secret-key

# Database settings
DATABASE_URL=postgresql://user:password@localhost:5432/ragbotdb

# OpenAI API key
OPENAI_API_KEY=your-openai-api-key

# Qdrant settings
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Additional configuration
SQLALCHEMY_TRACK_MODIFICATIONS=False
"""

# Write to .env.example
with open("/mnt/data/.env.example", "w") as f:
    f.write(env_example_content)

